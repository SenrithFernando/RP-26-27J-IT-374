# Copy to .env and enter the password locally. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saferide_routing
DB_USER=saferide_app
# Single quotes preserve #, spaces and ${...} literally (interpolation is disabled).
# Escape a literal single quote with backslash inside this quoted value.
DB_PASSWORD=

# Backend only. auto selects Google only when its key exists; otherwise manual.
GEOCODING_PROVIDER=auto
GOOGLE_GEOCODING_API_KEY=

# Initial pre-trip defaults only when a vehicle/direction has no saved settings.
# Existing generation settings are reused; unknown school bell times are never invented.
PLANNING_MORNING_DEPARTURE_SECONDS=21600
PLANNING_AFTERNOON_DEPARTURE_SECONDS=45000
PLANNING_PICKUP_SERVICE_SECONDS=30
PLANNING_DELIVERY_SERVICE_SECONDS=30
PLANNING_SOLVER_LIMIT_SECONDS=2

# Backend only. Routes API must be enabled with billing for live traffic.
GOOGLE_ROUTES_API_KEY=
# Optional Google-basemap display of returned road geometry (Static Maps API).
GOOGLE_STATIC_MAPS_API_KEY=
TRAFFIC_HTTP_TIMEOUT_SECONDS=4
TRAFFIC_MATRIX_BUDGET_SECONDS=12

# Stage 9B: snapshotted on trip start; metres and GPS-recorded seconds.
ARRIVAL_RADIUS_METRES=50
ARRIVAL_EXIT_RADIUS_METRES=75
ARRIVAL_DWELL_SECONDS=15
ARRIVAL_MIN_OBSERVATIONS=3
ARRIVAL_MAX_GAP_SECONDS=10
ARRIVAL_FRESHNESS_SECONDS=20

# Stage 9C provisional policy. Production is always 900 s.
PICKUP_MORNING_SCOPE=per_stop
PICKUP_AFTERNOON_SCOPE=per_school
PICKUP_DEMO_DURATION_SECONDS=30
PICKUP_WORKER_INTERVAL_SECONDS=1
# Accelerated mode is an explicit per-trip API/UI choice, simulation-only.

# Stage 9E provisional operational thresholds, snapshotted on trip start.
OPS_ROAD_DEVIATION_METRES=100
OPS_SEQUENCE_DEVIATION_METRES=300
OPS_DEVIATION_SECONDS=20
OPS_RECOVERY_SECONDS=10
OPS_STOP_SECONDS=60
OPS_LOW_MOVEMENT_MPS=0.5
OPS_STOP_RADIUS_METRES=15
OPS_STOP_RECOVERY_METRES=30
OPS_EXPECTED_DWELL_RADIUS_METRES=75
OPS_MAX_GAP_SECONDS=10
OPS_FRESHNESS_SECONDS=20
OPS_MIN_OBSERVATIONS=3
# Deviation recovery radius is 60% of the selected geometry-specific threshold.

# Phone samples above this accuracy radius are retained but excluded from transitions.
GPS_POOR_ACCURACY_METRES=50
